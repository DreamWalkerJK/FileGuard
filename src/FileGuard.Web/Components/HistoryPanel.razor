@inject WebWorkspace Workspace
<section class="panel"><div class="section-head"><h2>持久化事件记录</h2><span>@History.Total 项</span></div><div class="table-wrap"><table><thead><tr><th>时间</th><th>动作 / 对象</th><th>结果</th><th>安全检查</th></tr></thead><tbody>@foreach (var entry in History.Items) { <tr><td>@Ui.Time(entry.Utc)</td><td>@entry.Action<small class="id">@entry.SubjectId</small></td><td>@entry.Result</td><td>@entry.SafetyCheck</td></tr> }@if (History.Total == 0) { <tr><td colspan="4" class="empty">还没有操作历史。扫描、计划与文件操作发生后可在这里核对。</td></tr> }</tbody></table></div><Pager Total="History.Total" PageNumber="PageNumber" BaseUrl="/?tab=history" /></section>
@code { [Parameter] public int PageNumber { get; set; } private Page<AuditEvent> History = new([], 0, 0, 25); protected override void OnParametersSet() => History = Workspace.Store.ListHistory(Ui.Offset(PageNumber), 25); }
